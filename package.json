{
  "name": "waymark",
  "version": "1.0.0",
  "description": "Self-hosted, private link shortener. Runs free on Cloudflare Workers + D1, or anywhere with Node and SQLite.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "WAYMARK_DEV=1 tsx watch src/server/entry/node.ts",
    "dev:web": "vite",
    "dev:worker": "npm run build:web && wrangler dev",
    "build": "npm run build:web && npm run build:node",
    "build:web": "vite build",
    "build:node": "esbuild src/server/entry/node.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server/node.mjs --external:@libsql/client --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "start": "node --disable-warning=ExperimentalWarning dist/server/node.mjs",
    "deploy": "npm run build:web && wrangler deploy",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.17",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@libsql/client": "^0.18.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  }
}
